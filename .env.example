# Copy to .env (never committed) or to ~/.config/reelforge/secrets.env (mode 600). Names only: put your own values.
# Lookup order: environment > repository .env > ~/.config/reelforge/secrets.env.

# --- GPU voice (RunPod serverless) ---
RUNPOD_API_KEY=
# Daily GPU spending cap in USD, all reels together (default 3).
# REELFORGE_GPU_DAILY_CAP=3

# --- script writing ---
# stub (default, fixtures, free) | api (publishable) | claude-code (test only: reels are flagged not publishable)
# REELFORGE_LLM=stub
# Key of the Anthropic API, used when REELFORGE_LLM=api
REELFORGE_ANTHROPIC_API_KEY=
# LLM spending cap per reel in USD (default 5; 0 forbids any spend; off removes the cap)
# REELFORGE_LLM_BUDGET=5

# --- defaults ---
# REELFORGE_LANGUAGE=en
# gpu (production) | stub (tests: deterministic beeps)
# REELFORGE_VOICE=stub
